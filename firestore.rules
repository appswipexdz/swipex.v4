rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // بيانات المستخدمين الأساسية
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId}/data/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ══════════════════════════════════════════════════════════���════
    // البنية الجديدة V2: طرود فردية + أرشيف فردي + بيانات مزامنة
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId}/parcels_v2/{tracking} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/archive_v2/{tracking} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/_syncMeta/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
