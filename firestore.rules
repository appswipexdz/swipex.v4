rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // بيانات المستخدمين الأساسية
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId}/data/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════════════════════════
    // البنية الجديدة V2: طرود فردية + أرشيف فردي + بيانات مزامنة
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId}/parcels_v2/{tracking} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/archive_v2/{tracking} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/_syncMeta/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════════════════════════
    // نظام الجلسات التعاونية (Sessions)
    // ═══════════════════════════════════════════════════════════════
    match /sessions/{sessionId} {

      function isAuthenticated() {
        return request.auth != null;
      }

      function isParticipant() {
        return isAuthenticated() &&
          exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid));
      }

      function getParticipantRole() {
        return get(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid)).data.role;
      }

      function isOwner() {
        return isAuthenticated() &&
          resource.data.createdByUid == request.auth.uid;
      }

      function hasRole(roles) {
        return isParticipant() && (getParticipantRole() in roles);
      }

      // الجلسة: قراءة للمشاركين فقط
      allow read: if isParticipant();

      // إنشاء جلسة لأي مستخدم مسجل
      allow create: if isAuthenticated();

      // تعديل/حذف للمالك فقط
      allow update, delete: if isOwner();

      // ═══════════════════════════════════════════════════════════════
      // المشاركون
      // ═══════════════════════════════════════════════════════════════
      match /participants/{userId} {
        allow read: if isParticipant();
        allow create: if isAuthenticated();

        allow update, delete: if isAuthenticated() &&
          (request.auth.uid == userId || hasRole(['owner', 'admin']));
      }

      // ═══════════════════════════════════════════════════════════════
      // الطرود داخل الجلسة
      // ═══════════════════════════════════════════════════════════════
      match /parcels/{parcelId} {
        allow read: if isParticipant();
        allow write: if isAuthenticated() &&
          (hasRole(['owner', 'admin', 'editor']));
      }

      // ═══════════════════════════════════════════════════════════════
      // سجل النشاطات (ثابت)
      // ═══════════════════════════════════════════════════════════════
      match /activity/{activityId} {
        allow read: if isParticipant();
        allow create: if isParticipant();

        allow update, delete: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // الدعوات (Invites) — collection عامة مستقلة
    // التطبيق يكتب: doc(db, 'invites', inviteId)
    // ═══════════════════════════════════════════════════════════════
    match /invites/{inviteId} {
      function isAuthenticated() {
        return request.auth != null;
      }

      // ملاحظة: token.email عادةً متوفر إذا المستخدم سجّل عبر Google.
      function isInvitee() {
        return isAuthenticated() &&
          request.auth.token.email.toLowerCase() == resource.data.email;
      }

      function inviterIsOwnerOrAdmin() {
        return isAuthenticated() &&
          exists(/databases/$(database)/documents/sessions/$(resource.data.sessionId)/participants/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)/participants/$(request.auth.uid)).data.role in ['owner', 'admin'];
      }

      // قراءة: المدعو أو المُرسِل
      allow read: if isAuthenticated() && (isInvitee() || request.auth.uid == resource.data.invitedByUid);

      // إنشاء الدعوة: فقط owner/admin في الجلسة
      allow create: if inviterIsOwnerOrAdmin();

      // قبول/رفض: فقط المدعو
      allow update: if isInvitee();

      // حذف ممنوع افتراضيًا
      allow delete: if false;
    }
  }
}
