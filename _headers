/*
  Cache-Control: max-age=0, must-revalidate

# كاش المتصفح يُبطئ العمل دون اتصال، لكنه لا يمنع CacheStorage الخاص
# بـ Service Worker (وهو ما يبقي التطبيق يعمل بدون إنترنت).
# لذا نكتفي بإعادة التحقق السريع بدل no-store.

/*.html
  Cache-Control: max-age=0, must-revalidate

/*.js
  Cache-Control: max-age=0, must-revalidate

/*.css
  Cache-Control: max-age=0, must-revalidate

/assets/libs/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: max-age=0, must-revalidate

# الملف نفسه يجب أن يُجلب دائماً وإلا تجمّد Service Worker على الأجهزة القديمة
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/app-version.json
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: max-age=0, must-revalidate
